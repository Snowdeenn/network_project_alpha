{
  "version": 1,
  "name": "impact_light_flash",
  "family": "light",
  "logical": {
    "emission": {
      "mode": "burst",
      "count": 1,
      "delay_seconds": 0.0
    },
    "initialization": {
      "space": "world",
      "position": {
        "shape": "point",
        "value": [
          0.0,
          0.0
        ]
      },
      "lifetime_seconds": {
        "min": 0.2,
        "max": 0.2
      }
    },
    "logical_death": {
      "when": [
        "lifetime_expired",
        "death_requested"
      ],
      "on_death": {
        "stop_simulation": true
      }
    }
  },
  "visual": {
    "representations": [
      {
        "name": "flash",
        "type": "point_light"
      }
    ],
    "appearance": {
      "representation": "flash",
      "color": [
        1.0,
        0.65,
        0.25
      ],
      "intensity": 4.0,
      "radius": 96.0,
      "casts_shadows": false,
      "initial_state": "bright"
    },
    "states": {
      "bright": {},
      "dim": {}
    },
    "transitions": [
      {
        "from": "bright",
        "to": "dim",
        "when": {
          "type": "normalized_age",
          "at_least": 0.0
        },
        "duration_seconds": 0.18,
        "target": {
          "intensity": 0.3,
          "radius": 48.0,
          "color": [
            1.0,
            0.25,
            0.05
          ]
        }
      }
    ],
    "visual_disappearance": {
      "trigger": "logical_death",
      "duration_seconds": 0.08,
      "intensity": {
        "from": "current",
        "to": 0.0
      },
      "on_complete": "release_light"
    }
  }
}