{
  "version": 1,
  "name": "weapon_energy_trail",
  "family": "trail",

  "logical": {
    "emission": {
      "mode": "continuous",
      "rate_per_second": 60.0,
      "delay_seconds": 0.0,
      "duration_seconds": 0.45
    },
    "initialization": {
      "space": "world",
      "position": {
        "shape": "attachment",
        "source": "weapon_tip"
      },
      "lifetime_seconds": {
        "min": 0.8,
        "max": 0.8
      }
    },
    "evolution": {
      "point_lifetime_seconds": 0.35,
      "max_points": 64
    },
    "logical_death": {
      "when": [
        "lifetime_expired",
        "death_requested"
      ],
      "on_death": {
        "stop_emission": true,
        "stop_simulation": true
      }
    }
  },

  "visual": {
    "representations": [
      {
        "name": "energy_ribbon",
        "type": "ribbon",
        "texture": "textures/vfx/energy_trail.png"
      }
    ],
    "appearance": {
      "representation": "energy_ribbon",
      "blend": "additive",
      "width": 6.0,
      "color": [
        0.2,
        0.65,
        1.0,
        1.0
      ],
      "orientation": "path",
      "uv_mode": "stretch",
      "initial_state": "active"
    },
    "states": {
      "active": {},
      "cooling": {}
    },
    "transitions": [
      {
        "from": "active",
        "to": "cooling",
        "when": {
          "type": "normalized_age",
          "at_least": 0.5625
        },
        "duration_seconds": 0.2,
        "target": {
          "width": 2.0,
          "color": [
            0.1,
            0.25,
            0.8,
            0.4
          ]
        }
      }
    ],
    "visual_disappearance": {
      "trigger": "logical_death",
      "duration_seconds": 0.15,
      "orientation": "freeze",
      "alpha": {
        "from": "current",
        "to": 0.0
      },
      "on_complete": "release_trail"
    }
  }
}
