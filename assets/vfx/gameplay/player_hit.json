{
  "version": 1,
  "name": "gameplay/player_hit",
  "family": "post-process",
  "logical": {
    "initialization": {
      "lifetime_seconds": {
        "min": 0.2,
        "max": 0.2
      }
    },
    "logical_death": {
      "when": [
        "lifetime_expired",
        "death_requested"
      ],
      "on_death": {
        "stop_simulation": true
      }
    }
  },
  "visual": {
    "representations": [
      {
        "material": "hit_flash",
        "name": "screen",
        "type": "post_process_pass"
      }
    ],
    "appearance": {
      "envelope": {
        "fade_in_seconds": 0.0,
        "fade_out_seconds": null
      },
      "weight": 1.0,
      "parameters": {},
      "representation": "screen",
      "initial_state": "active"
    },
    "states": {
      "active": {}
    },
    "transitions": [],
    "visual_disappearance": {
      "trigger": "logical_death",
      "duration_seconds": 0.0,
      "weight": {
        "from": "current",
        "to": 0.0
      },
      "on_complete": "release_post_process"
    }
  }
}
